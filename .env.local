# BP-ECG ETL - Local Development Environment
# Copie este arquivo para .env para uso local

# ===== S3 Configuration =====
INPUT_BUCKET=raw-pdfs
OUTPUT_BUCKET=anon-pdfs
AWS_REGION=us-east-1

# ===== AWS Credentials (LocalStack ou AWS real) =====
# Para LocalStack (desenvolvimento local)
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Para AWS real, comente as linhas acima e descomente abaixo:
# AWS_ACCESS_KEY_ID=sua_access_key_aqui
# AWS_SECRET_ACCESS_KEY=sua_secret_key_aqui

# ===== Concurrency Configuration =====
# Otimizado para 8 vCPUs + 16GB RAM
MAX_WORKERS=100
QUEUE_SIZE=400

# Para testes locais com menos recursos, use:
# MAX_WORKERS=10
# QUEUE_SIZE=50

# ===== Processing Configuration =====
DPI_PAGE2_RENDER=150
LINE_TOLERANCE=1.0
PREVLINE_TOLERANCE=10.0
PADDING=1.0

# ===== Logging =====
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
