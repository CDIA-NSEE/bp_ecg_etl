# BP-ECG ETL - Production Environment Configuration (OPTIMIZED)
# ================================================================

# S3 Buckets
INPUT_BUCKET=raw-pdfs
OUTPUT_BUCKET=anon-pdfs
AWS_REGION=us-east-1

# ============================================================
# PERFORMANCE OPTIMIZATION (8 vCPUs + 16GB RAM - RECOMMENDED)
# ============================================================

# Async I/O Workers - High concurrency for S3 operations
# Increase for better I/O throughput, decrease if hitting memory limits
MAX_WORKERS=200

# CPU Process Workers - True parallelism for PDF processing
# Set to 0 for auto-detect (2x CPU count)
# Manual: 16 for 8 vCPUs, 32 for 16 vCPUs, 64 for 32 vCPUs
MAX_PROCESS_WORKERS=16

# Queue Size - Buffer between producer and consumers
# Recommended: 4x MAX_WORKERS
QUEUE_SIZE=800

# Batch Upload - Upload PDFs in batches for efficiency
BATCH_UPLOAD_SIZE=50

# ============================================================
# PDF PROCESSING OPTIMIZATION
# ============================================================

# DPI for Page 2 Rasterization
# 220 = good (web), 300 = high (print), 600 = very high (archive)
# OPTIMIZED: 300 provides excellent quality with 4x better performance than 600
DPI_PAGE2_RENDER=300

# ZIP Compression Level (1-9)
# 1 = fastest, 9 = best compression
# OPTIMIZED: 3 provides fast compression with good ratio (40% faster than level 6)
ZIP_COMPRESSION_LEVEL=3

# ============================================================
# S3 CONNECTION OPTIMIZATION
# ============================================================

# S3 Connection Pool - Max concurrent S3 connections
# Higher = better throughput, but more memory
S3_MAX_POOL_CONNECTIONS=50

# S3 Timeouts (seconds)
S3_CONNECT_TIMEOUT=5
S3_READ_TIMEOUT=30

# ============================================================
# ANONYMIZATION PARAMETERS
# ============================================================

# Text detection tolerances
LINE_TOLERANCE=1.0
PREVLINE_TOLERANCE=10.0
PADDING=1.0

# ============================================================
# ALTERNATIVE CONFIGURATIONS BY HARDWARE
# ============================================================

# 4 vCPUs + 8GB RAM (Budget)
# MAX_WORKERS=100
# MAX_PROCESS_WORKERS=8
# QUEUE_SIZE=400
# S3_MAX_POOL_CONNECTIONS=30

# 16 vCPUs + 32GB RAM (High Performance)
# MAX_WORKERS=400
# MAX_PROCESS_WORKERS=32
# QUEUE_SIZE=1600
# S3_MAX_POOL_CONNECTIONS=100

# 32 vCPUs + 64GB RAM (Maximum)
# MAX_WORKERS=800
# MAX_PROCESS_WORKERS=64
# QUEUE_SIZE=3200
# S3_MAX_POOL_CONNECTIONS=150
