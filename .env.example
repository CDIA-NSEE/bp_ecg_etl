# AWS Configuration
INPUT_BUCKET=bp-ecg-input
OUTPUT_BUCKET=bp-ecg-output
AWS_REGION=us-east-1

# Processing Configuration
DPI_PAGE2_RENDER=300
LINE_TOLERANCE=1.0
PREVLINE_TOLERANCE=10.0
PADDING=1.0

# Image Processing
IMAGE_REDACT_MODE=RGB

